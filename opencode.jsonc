{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "tech-lead",
  "skills": {
    "paths": [
      "skills",
      ".opencode/skills"
    ]
  },
  "agent": {
    "build": {
      "disable": true,
      "disabled": true
    },
    "plan": {
      "disable": true,
      "disabled": true
    },
    "tech-lead": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": {
          "*": "allow"
        }
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "permission": {
        "read": "allow"
      },
      "skills": [
        "universal-agent-reviews",
        "apple-twostraws-concurrency"
      ]
    },
    "docs-writer": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "ios-engineer": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "skills": [
        "apple-stratos",
        "apple-twostraws-swiftui",
        "apple-twostraws-concurrency",
        "apple-twostraws-testing",
        "apple-flo-liquid-glass",
        "apple-rocketsim"
      ]
    },
    "journal-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    },
    "learnings-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow"
      }
    },
    "product-manager": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "qa-agent": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "skills": [
        "apple-rocketsim",
        "apple-twostraws-testing"
      ]
    },
    "senior-architect": {
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      },
      "skills": [
        "universal-archify",
        "apple-stratos"
      ]
    }
  }
}
